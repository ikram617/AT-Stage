{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.algerie.telecom.fatplanner",
    "productName": "FAT Planner",
    "forceCodeSigning": false,
    "icon": "src/assets/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icon.ico",
      "shortcutName": "FAT Planner",
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "src/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/FAT_Planner_Backend.exe",
        "to": "FAT_Planner_Backend.exe"
      }
    ],
    "directories": {
      "output": "C:\\Users\\blabl\\OneDrive\\Desktop\\FATPlanner"
    }
  }
}

